// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // Hashed password
  name     String
  role     String // "ADMIN", "PET_OWNER", "VET", "NGO", "PUBLIC"
  username String? @unique
  lastUsernameChange DateTime?
  latitude Float?
  longitude Float?
  lastLocationChange DateTime?

  pets         Pet[]            @relation("OwnerPets")
  assignedPets Pet[]            @relation("VetPets")
  assignedVaccinations ScheduledVaccination[]
  strayReports StrayReport[]
  adoptions    AdoptionRecord[]
  chatMessages ChatMessage[]
  orders       Order[]
    birthdate   DateTime? // Optional birthdate
}

model Pet {
  id            Int     @id @default(autoincrement())
  name          String
  breed         String
  age           Int
  photoUrl      String?
  ownerId       String
  owner         User    @relation("OwnerPets", fields: [ownerId], references: [id])
  assignedVetId String?
  assignedVet   User?   @relation("VetPets", fields: [assignedVetId], references: [id])
  isListed      Boolean @default(false) // Listed for adoption

  medicalRecord         MedicalRecord?
  adoptionRecords       AdoptionRecord[]
  scheduledVaccinations ScheduledVaccination[]
    birthdate            DateTime? // Optional birthdate
}

model MedicalRecord {
  id           Int    @id @default(autoincrement())
  petId        Int    @unique
  pet          Pet    @relation(fields: [petId], references: [id])
  // Storing arrays as JSON strings in SQLite
  vaccinations String // JSON string: "['Rabies', 'Parvo']"
  treatments   String // JSON string
  healthLogs   String // JSON string
}

model ScheduledVaccination {
  id            Int      @id @default(autoincrement())
  petId         Int
  pet           Pet      @relation(fields: [petId], references: [id])
  vaccineName   String
  scheduledDate DateTime
  status        String   @default("PENDING") // "PENDING", "COMPLETED", "SKIPPED"
  reminderSent  Boolean  @default(false)
  notes         String?
  assignedVetId String?
  assignedVet   User?    @relation(fields: [assignedVetId], references: [id])
  createdAt     DateTime @default(now())
}

model StrayReport {
  id          Int      @id @default(autoincrement())
  location    String
  description String
  photoUrl    String?
  status      String // "REPORTED", "VERIFIED", "RESCUED", "RESOLVED"
  latitude    Float?
  longitude   Float?
  ngoStatus   String?  @default("PENDING")
  vetStatus   String?  @default("PENDING")
  ngoResponderId String?
  vetResponderId String?
  ngoUpdatedAt DateTime?
  vetUpdatedAt DateTime?
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  createdAt   DateTime @default(now())
}

model AdoptionRecord {
  id          Int      @id @default(autoincrement())
  petId       Int
  pet         Pet      @relation(fields: [petId], references: [id])
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id])
  status      String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  chatCreated Boolean  @default(false) // Whether chat has been created for this adoption
  createdAt   DateTime @default(now())
  chatMessages ChatMessage[]
}

model ChatMessage {
  id               Int            @id @default(autoincrement())
  adoptionRecordId Int
  senderId         String
  message          String
  createdAt        DateTime       @default(now())
  isRead           Int            @default(0)
  adoptionRecord   AdoptionRecord @relation(fields: [adoptionRecordId], references: [id])
  sender           User           @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  ngoId     String
  reportId  Int
  message   String?
  createdAt DateTime @default(now())
  read      Int      @default(0)

  @@map("notifications")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Float
  stock       Int
  orderItems  OrderItem[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    String // "PENDING", "SHIPPED", "DELIVERED"
  total     Float
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}
